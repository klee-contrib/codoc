{
  "compilerOptions": {
    "lib": ["es2023", "dom"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "es2023",
    "noEmit": true,
    "importHelpers": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["./src/**/*"],
  "ts-node": {
    "esm": true
  }
}
